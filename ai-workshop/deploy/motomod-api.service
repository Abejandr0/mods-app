[Unit]
Description=MotoMod FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=motomod
Group=motomod
WorkingDirectory=/opt/motomod/ai-workshop/backend
EnvironmentFile=/etc/motomod.env
ExecStart=/opt/motomod/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
