GEMINI_API_KEY=tu_clave_de_google_ai_studio
# Opcional: deja vacío para guardar cuentas localmente con SQLite.
# En producción pega la URL de conexión PostgreSQL de Neon.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# FRONTEND_URL=https://tu-frontend.onrender.com
# true cuando publiques el backend tras HTTPS
SECURE_COOKIES=false
# Modelo de texto Gemini con nivel gratuito, sujeto a la cuota vigente del proyecto.
# GEMINI_MODEL=gemini-3.1-flash-lite
# FAL_KEY=opcional; el servicio de edición de imágenes de fal.ai cobra por uso.
